{
  "name": "nuvio-enhanced",
  "private": true,
  "type": "module",
  "version": "1.1.12",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "npm run test:plugins",
    "test:plugins": "npm run build && node ./tests/test-plugin-system.mjs && node ./tests/test-plugin-localization.mjs",
    "prepare": "husky || true",
    "build:on-release": "node ./scripts/release-build-poller.mjs",
    "install:webos": "node ./scripts/ares-install-webos.mjs",
    "inspect:webos": "node ./scripts/ares-inspect-webos.mjs",
    "logs:webos": "node ./scripts/ares-logs-webos.mjs",
    "media:webos-sim": "node --require ./scripts/localhost-listen-patch.cjs ./services/webos/runtime/media-http.cjs",
    "lint": "npm run lint:home:incremental && npm run lint:runtime",
    "lint:home:incremental": "eslint \"js/ui/screens/home/**/*.js\" \"eslint.config.mjs\"",
    "lint:runtime": "eslint \"js/**/*.js\" --quiet --rule \"no-unused-vars: off\"",
    "package:tizen": "npm run build && node ./scripts/package-tizen.mjs",
    "package:tizen:store": "npm run build && node ./scripts/package-tizen.mjs --store",
    "package:webos": "npm run build && node ./scripts/package-webos.mjs",
    "simulator:webos": "npm run build && node ./scripts/package-webos.mjs --simulator",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "node ./scripts/serve.mjs",
    "sync": "node ./scripts/sync-wrapper.mjs",
    "sync:tizen": "node ./scripts/sync-wrapper.mjs --tizen",
    "sync:webos": "node ./scripts/sync-wrapper.mjs --webos"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^9.39.4",
    "@webos-tools/cli": "^3.2.6",
    "autoprefixer": "^10.6.1",
    "core-js": "3.50.0",
    "core-js-compat": "3.50.0",
    "cssnano": "^7.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8"
  },
  "overrides": {
    "flatted": "3.4.2"
  },
  "dependencies": {
    "assjs": "0.1.10",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.2.0",
    "dashjs": "5.2.1",
    "hls.js": "1.7.3",
    "jszip": "^3.10.2",
    "libbitsub": "^1.12.1",
    "quickjs-emscripten": "^0.32.0"
  }
}
